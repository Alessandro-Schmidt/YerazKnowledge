{
  "name": "yeraz",
  "private": true,
  "version": "0.0.0",
  "description": "A note-taking app whose notes live as Markdown in your own GitHub repositories, shown as a map of how they connect.",
  "license": "MIT",
  "author": "Alessandro M. Schmidt <alessandromacielschmidt@hotmail.com> (https://github.com/Alessandro-Schmidt)",
  "homepage": "https://yeraznotes.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alessandro-Schmidt/YerazKnowledge.git"
  },
  "bugs": {
    "url": "https://github.com/Alessandro-Schmidt/YerazKnowledge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:fake": "vite --mode fake",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "size": "size-limit",
    "fixture": "tsx scripts/make-fixture.ts",
    "import": "tsx scripts/import-notes.ts",
    "perf": "playwright test -c playwright.perf.config.ts",
    "visual": "playwright test -c playwright.visual.config.ts",
    "contract": "playwright test -c playwright.contract.config.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@tauri-apps/api": "2.12.4",
    "d3-contour": "4.0.2",
    "d3-hierarchy": "3.1.2",
    "d3-selection": "3.0.0",
    "d3-shape": "3.2.0",
    "d3-zoom": "3.0.0",
    "emojibase-data": "18.0.0",
    "idb-keyval": "6.3.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-footnote": "4.0.0",
    "mermaid": "12.2.0",
    "node-diff3": "3.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.36.0",
    "wouter": "3.13.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.2.0",
    "@tauri-apps/cli": "2.12.1",
    "@types/d3-contour": "3.0.6",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-selection": "3.0.12",
    "@types/d3-shape": "3.2.0",
    "@types/d3-zoom": "3.0.9",
    "@types/markdown-it": "14.2.0",
    "@types/markdown-it-footnote": "3.0.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cross-env": "10.1.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "msw": "2.15.0",
    "prettier": "3.9.10",
    "size-limit": "14.2.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  }
}
